# Test Data Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com

# Password for dynamically registered test users (must meet API complexity rules)
TEST_USER_PASSWORD=

# Pre-seeded demo customer — use for NEGATIVE login tests only
TEST_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
TEST_CUSTOMER_PASSWORD=

# Optional: second demo account
TEST_CUSTOMER2_EMAIL=customer2@practicesoftwaretesting.com
TEST_CUSTOMER2_PASSWORD=

# Optional: admin account (out of scope for assessment — do not use in automation)
TEST_ADMIN_EMAIL=admin@practicesoftwaretesting.com
TEST_ADMIN_PASSWORD=
